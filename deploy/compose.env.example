# Rede Docker user-defined na qual o PostgreSQL existente já está conectado.
POSTGRES_NETWORK=replace-with-existing-postgres-network

# URLs da base Conta Clara. Use o nome DNS/alias do container Postgres na rede acima.
# Troque usuários, senhas e base pelos valores criados conforme docs/database.md.
DATABASE_URL=postgresql://conta_clara_app:replace-this-password@postgres:5432/conta_clara
MIGRATION_DATABASE_URL=postgresql://conta_clara_migrator:replace-this-password@postgres:5432/conta_clara

# localhost permite usar no próprio computador. Para celular, use IP fixo/reservado
# ou nome DNS local que resolva para este servidor na rede doméstica.
LAN_HOST=localhost
LAN_BIND_ADDRESS=127.0.0.1
HTTPS_PORT=8443
