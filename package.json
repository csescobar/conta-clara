{
  "name": "conta-clara",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite --host 127.0.0.1",
    "test": "vitest run",
    "e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build && npm run test:db && npm run e2e && bash scripts/backup-restore-drill.sh",
    "hooks:install": "git config core.hooksPath .githooks",
    "test:db": "node --env-file-if-exists=.env.test node_modules/vitest/vitest.mjs run --config vitest.db.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.server.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build": "vite build && node scripts/check-production-bundle.js",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:status": "node --env-file-if-exists=.env scripts/migrate.js --status",
    "start": "node --env-file-if-exists=.env server/index.js"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "~1.1.23",
    "@radix-ui/react-dialog": "~1.1.23",
    "@radix-ui/react-dropdown-menu": "~2.1.24",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-toast": "~1.2.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-is": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "overrides": {
    "shell-quote": "^1.12.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^5.0.4",
    "axe-core": "^4.13.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.12.0",
    "jsdom": "^27.0.0",
    "prettier": "^3.9.9",
    "supertest": "^7.1.4",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.1.12",
    "vitest": "^4.1.11"
  }
}
